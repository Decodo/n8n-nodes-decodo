{
  "name": "@decodo/n8n-nodes-decodo",
  "version": "0.0.0-semantic-release",
  "description": "Decodo n8n integration",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Decodo/n8n-nodes-decodo#readme",
  "author": {
    "name": "Scraping Team",
    "email": "scraping@decodo.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Decodo/n8n-nodes-decodo.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "eslint -c .eslintrc.prepublish.js nodes credentials package.json",
    "format:check": "prettier nodes credentials --check"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DecodoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Decodo/Decodo.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@typescript-eslint/parser": "~8.32.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
